{
  "expo": {
    "name": "Amgi",
    "slug": "amgi",
    "version": "2.0.0",
    "scheme": [
      "amgi",
      "com.miinjaekim.amgi"
    ],
    "platforms": [
      "ios",
      "android"
    ],
    "userInterfaceStyle": "automatic",
    "icon": "./assets/icon.png",
    "plugins": [
      "./plugins/withoutPushEntitlement",
      "expo-router",
      "expo-web-browser",
      "expo-notifications",
      [
        "expo-audio",
        {
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ],
      "expo-sharing",
      "expo-status-bar",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#173F35"
        }
      ]
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.tegi.amgi",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.miinjaekim.amgi",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#173F35"
      }
    },
    "updates": {
      "url": "https://u.expo.dev/bc217cdf-916f-409f-868a-5994ff9813bf",
      "enabled": true,
      "checkAutomatically": "NEVER",
      "fallbackToCacheTimeout": 0
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "bc217cdf-916f-409f-868a-5994ff9813bf"
      }
    },
    "owner": "mjkim314"
  }
}
